# Hermes session data (may contain credentials, never commit)
.hermes/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Node
node_modules/

# Real-Data Production Path (FD #46): track approved pipeline artifacts + DB hygiene
/backend/data/*.db*

# Environment
.env
.env.*
*.env
!.env.example

# OS
.DS_Store
Thumbs.db
nul
output/
data/cache/*.json

# Reference books (FD #58): static PDFs stay out of git; extracted notes live in docs/industry-outlook/
docs/Books/

# Order matters: un-ignore AFTER the `output/` rule so the exceptions win (FD #46)
!fundamental-opportunity-v0/output/
fundamental-opportunity-v0/output/*
!fundamental-opportunity-v0/output/pipeline_result.json
!institutional-intelligence-v0/output/
institutional-intelligence-v0/output/*
!institutional-intelligence-v0/output/institutional_signals.json

# Equity Inflection Discovery (FD #89): scanner output + validation evidence are
